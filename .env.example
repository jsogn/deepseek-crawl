GATEWAY_API_KEY=replace-with-a-long-random-secret
DEEPSEEK_API_KEY=replace-with-deepseek-api-key

# Optional Firecrawl-first mode
FIRECRAWL_API_KEY=
FIRECRAWL_UPSTREAM_URL=https://api.firecrawl.dev
DEEPSEEK_GATEWAY_PROVIDER_MODE=firecrawl-first
DEEPSEEK_GATEWAY_CREDITS_COOLDOWN_SECONDS=60

# Optional local container port override
GATEWAY_PORT=8787
