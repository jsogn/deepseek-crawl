{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!.deepseek-crawl",
      "!.superpowers",
      "!docs/superpowers"
    ]
  }
}
