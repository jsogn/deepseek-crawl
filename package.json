{
  "name": "deepseek-crawl",
  "version": "0.5.0",
  "description": "CLI-first AI web search, page reading, mapping, and crawling with optional MCP",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "deepseek-crawl": "dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "prepack": "npm run build",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm pack --dry-run",
    "test:live": "npm run build && node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fast-xml-parser": "5.12.1",
    "markdown-it": "15.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
