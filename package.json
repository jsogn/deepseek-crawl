{
  "name": "deepseek-crawl",
  "version": "0.13.0",
  "description": "CLI-first AI web search, page reading, mapping, crawling, MCP, and an optional Firecrawl-compatible gateway",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/jsogn/deepseek-crawl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsogn/deepseek-crawl.git"
  },
  "bugs": {
    "url": "https://github.com/jsogn/deepseek-crawl/issues"
  },
  "keywords": [
    "deepseek",
    "crawl",
    "web-search",
    "mcp",
    "agent-skill",
    "cli",
    "firecrawl",
    "gateway",
    "proxy"
  ],
  "bin": {
    "deepseek-crawl": "dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "skills"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:test && npm test && npm run verify:package",
    "verify:package": "node scripts/verify-package-install.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "npm run verify && npm run check:release",
    "test:live": "npm run build && node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fast-xml-parser": "5.12.1",
    "markdown-it": "15.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.20.5",
    "firecrawl": "4.54.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
